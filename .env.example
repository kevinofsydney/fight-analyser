# Copy to .env and edit:  cp .env.example .env
# .env is gitignored. NEVER put real secrets in this file.

# --- Paths ---
DB_PATH=data/fightdb.duckdb
DOWNLOAD_DIR=data/sources
# Structured error log (one JSON line per error). Read with: fightdb errors
LOG_DIR=data/logs
# Your own picks from the My picks page. Keep it outside the database file; back it up.
PICKS_PATH=data/picks.sqlite

# --- Data sources (see docs/DATA_SOURCES.md) ---
# fight_canon | greco
HISTORY_SOURCE=fight_canon
HISTORY_STALE_DAYS=7
# Refresh fails (old DB kept) if these data-quality limits are broken
DQ_MAX_NULL_REACH=0.15
DQ_MIN_STATS_COVERAGE=0.95
HTTP_USER_AGENT=fight-analyser/0.1 (+https://github.com/kevinofsydney/fight-analyser)

# --- Refresh schedule (homelab refresher container; cron syntax, UTC) ---
REFRESH_CRON=0 11 * * *

# --- App ---
# metric | imperial | both
UNITS=both
STALE_AFTER_HOURS=36
DB_MAX_AGE_HOURS=12
# Free-hosting path: where the app downloads the DB from (leave blank on homelab)
DATA_RELEASE_URL=

# --- Optional secrets (leave blank if unused) ---
APP_PASSWORD=
DISCORD_WEBHOOK_URL=
CLOUDFLARE_TUNNEL_TOKEN=
# Optional: The Odds API key for daily upcoming Australian bookmaker odds.
ODDS_API_KEY=
